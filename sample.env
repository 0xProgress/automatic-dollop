# ─── Required ──────────────────────────────────────────────────────────────
# Must be a single-line JSON array. Escape inner quotes if your shell mangles them.
# [
#     {
#         "username": "xxx",
#         "password": "xxx"
#     },
#     {
#         "username": "xxx",
#         "password": "xxx"
#     }
# ]
USERS_JSON=[{"username":"you@example.com","password":"yourpassword"}]

# ─── Optional: Telegram notifications ──────────────────────────────────────
TG_BOT_TOKEN=
TG_CHAT_ID=

# ─── Optional: Proxy ───────────────────────────────────────────────────────
# Format: http://[user:pass@]host:port
HTTP_PROXY=

# ─── Optional: Chrome path override ────────────────────────────────────────
# Leave blank on Linux CI (defaults to /usr/bin/google-chrome).
# On Windows, point at the real exe:
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
